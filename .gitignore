# =============================================================
# GeoSJC — .gitignore
# Coloque este arquivo na raiz do repositório (ao lado do README.md)
# =============================================================

# ---------- Node / React / Vite (pasta web/)
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Python (pipeline/ e api/)
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# ---------- Dados grandes / baixados (NÃO vão para o GitHub)
# base de CEPs geolocalizados (~5 GB) — baixar com git clone, ver README
pipeline/banco-ceps/
banco-ceps/
# base original da RAIS (muito grande); a base tratada entra só se for pequena
RAIS_ESTAB_PUB.txt
*.7z

# ---------- Segredos e configurações locais
.env
.env.*
!.env.example

# ---------- Office e Power BI: arquivos temporários
# (arquivos abertos no Excel/Word criam uma cópia "~$..." enquanto estão em uso)
~$*
*.tmp
# backups automáticos do Power BI
*.pbix.bak
# pasta de cache do modo Projeto do Power BI (.pbip)
**/.pbi/localSettings.json
**/.pbi/cache.abf

# ---------- Sistema operacional
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
# Linux
*~
.directory

# ---------- Editores
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
